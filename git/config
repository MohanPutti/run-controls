# Included from ~/.gitconfig via include.path. Holds no name or email.
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = false
