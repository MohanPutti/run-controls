# Developer tools baseline. Install: brew bundle --file=Brewfile

# Access / cluster (staging EKS, read-only role)
brew "awscli"
brew "kubectl"

# Per-repo toolchains (Rails, Nuxt/Node)
brew "mise"         # ruby / node versions from each repo's version files
brew "gh"
brew "ripgrep"

# Productivity
brew "fzf"          # fuzzy history (ctrl-r), file and branch picking
brew "zoxide"       # `z repo-name` jumps to repos you've visited
brew "fd"           # fast file find
brew "bat"          # cat with syntax highlighting
brew "delta"        # readable git diffs
brew "atuin"        # history search by directory and exit status (local only)
brew "direnv"       # per-repo env vars, pairs with mise
brew "tmux"         # parallel sessions that survive closed terminals
brew "starship"     # prompt: git branch, exit status, kube context off by default
brew "k9s"          # terminal UI for the cluster (use k9 for read-only)

# Optional: kubectx, eza, just, git-absorb, watchexec
